# ─────────────────────────────────────────────────────────────────────────────
# Ephor environment — COPY this file to `.env` and fill in values.
# NEVER commit `.env`. NEVER put a mainnet key here. Testnet only.
# All Arc facts verified Jul 14–17 2026 — re-verify via the Arc docs MCP before deploy.
# ─────────────────────────────────────────────────────────────────────────────

# ── Arc testnet ──
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002
ARC_EXPLORER_URL=https://testnet.arcscan.app
# forge verify-contract target (fill if Arc exposes an Etherscan-compatible verifier):
ARC_VERIFIER_URL=
ARC_ETHERSCAN_API_KEY=

# ── Deployer key (TESTNET ONLY — throwaway wallet funded from the faucet) ──
# Faucet: https://faucet.circle.com  (20 / asset / 2h / address)
DEPLOYER_PRIVATE_KEY=

# ── Circle Developer-Controlled Wallets (demo actors: operator, successors, vendor) ──
# From the Circle Console (Agora account). ENV VARS ONLY — never embed in code.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=

# ── Onchain asset addresses (Arc testnet) ──
# USDC is 6-dec ERC-20 (brief: 0x36…00). Confirm the full address on deploy.
USDC_ADDRESS=
EURC_ADDRESS=0x89B50855Aa3bE2F677cD6303Cec089B5F319D72a
USYC_ADDRESS=0xe9185F0c5F296Ed1797AaE4238D26CCaBEadb86C
USYC_TELLER_ADDRESS=0x9fdF14c5B14173D74C08Af27AebFf39240dC105A
# Entitlements may gate USYC minting (day-1 probe). Fallback: labeled MockYieldVault.
USYC_ENTITLEMENTS_ADDRESS=
TOKEN_MESSENGER_V2_ADDRESS=0x8FE6B999Dc680CcFDD5Bf7EB0974218be2542DAA
CCTP_ARC_DOMAIN=26
MEMO_ADDRESS=0x5294E9927c3306DcBaDb03fe70b92e01cCede505

# ── Cross-chain (CCTP v2 Arc → Base Sepolia demo leg) ──
BASE_SEPOLIA_RPC_URL=
BASE_SEPOLIA_DOMAIN=6

# ── Keeper / provider ──
# DATA_MODE gates LiveEphorProvider vs MockEphorProvider. The design app reads
# NEXT_PUBLIC_DATA_MODE; the keeper reads DATA_MODE. Keep them consistent.
DATA_MODE=mock
KEEPER_POLL_BLOCKS=5
KEEPER_DB_PATH=./apps/keeper/data/ephor.sqlite
DEPLOYMENTS_PATH=./scripts/deployments/arc-testnet.json
