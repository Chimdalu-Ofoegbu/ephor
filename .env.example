# ─────────────────────────────────────────────────────────────────────────────
# Ephor environment — COPY this file to `.env` and fill in values.
# NEVER commit `.env`. NEVER put a mainnet key here. Testnet only.
# All Arc facts verified Jul 14–17 2026 — re-verify via the Arc docs MCP before deploy.
# ─────────────────────────────────────────────────────────────────────────────

# ── Arc testnet ──
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002
ARC_EXPLORER_URL=https://testnet.arcscan.app
# forge verify-contract target (fill if Arc exposes an Etherscan-compatible verifier):
ARC_VERIFIER_URL=
ARC_ETHERSCAN_API_KEY=

# ── Deployer key (TESTNET ONLY — throwaway wallet funded from the faucet) ──
# Faucet: https://faucet.circle.com  (20 / asset / 2h / address)
DEPLOYER_PRIVATE_KEY=

# ── Demo actor wallets (plain throwaway EOAs — TESTNET ONLY) ──
# Ephor uses plain EOAs for the demo actors instead of Circle developer-controlled
# wallets (the contracts only ever see addresses). Generate a full set with:
#     pnpm wallets:gen
# then paste the printed block below. Fund each address (except the vendor) with a
# little USDC from the faucet — USDC is gas on Arc, so every sender needs some.
OPERATOR_PRIVATE_KEY=
SUCCESSOR1_PRIVATE_KEY=
SUCCESSOR2_PRIVATE_KEY=
GUARDIAN1_PRIVATE_KEY=
GUARDIAN2_PRIVATE_KEY=
GUARDIAN3_PRIVATE_KEY=
VENDOR_PRIVATE_KEY=

# ── Guardian addresses (Guardian2of3 constructor; consumed by the deploy script) ──
# `pnpm wallets:gen` derives these from the guardian keys above — paste them here.
GUARDIAN_1=
GUARDIAN_2=
GUARDIAN_3=

# ── Onchain asset addresses (Arc testnet — confirmed via Arc docs, Aug 2 2026) ──
# USDC is the native gas token AND a 6-dec ERC-20 at this address (transfer / approve /
# transferFrom / balanceOf). This is the real address, not a placeholder.
USDC_ADDRESS=0x3600000000000000000000000000000000000000
EURC_ADDRESS=0x89B50855Aa3bE2F677cD6303Cec089B5F319D72a
USYC_ADDRESS=0xe9185F0c5F296Ed1797AaE4238D26CCaBEadb86C
USYC_TELLER_ADDRESS=0x9fdF14c5B14173D74C08Af27AebFf39240dC105A
# Entitlements may gate USYC minting (day-1 probe). Fallback: labeled MockYieldVault.
USYC_ENTITLEMENTS_ADDRESS=0xcc205224862c7641930c87679e98999d23c26113
TOKEN_MESSENGER_V2_ADDRESS=0x8FE6B999Dc680CcFDD5Bf7EB0974218be2542DAA
CCTP_ARC_DOMAIN=26
MEMO_ADDRESS=0x5294E9927c3306DcBaDb03fe70b92e01cCede505

# ── Cross-chain (CCTP v2 Arc → Base Sepolia demo leg) ──
BASE_SEPOLIA_RPC_URL=
BASE_SEPOLIA_DOMAIN=6

# ── Keeper / provider ──
# DATA_MODE gates LiveEphorProvider vs MockEphorProvider. The design app reads
# NEXT_PUBLIC_DATA_MODE; the keeper reads DATA_MODE. Keep them consistent.
DATA_MODE=mock
KEEPER_POLL_BLOCKS=5
KEEPER_DB_PATH=./apps/keeper/data/ephor.sqlite
# Optional. The keeper defaults to ../../contracts/deployments/arc-testnet.json
# (where Deploy.s.sol writes the deployed addresses). Only set this if you move it.
# DEPLOYMENTS_PATH=
